# Copy to .env (git-ignored) and fill in only the provider you use.
# run.py loads .env from the repo root; real environment variables take precedence.
# The mock provider needs nothing and runs fully offline.

# Default provider when --provider is not given: mock | openai | azure | ollama | vllm | openai-compatible | anthropic
AGENT_PROVIDER=mock
AGENT_MAX_STEPS=8

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Azure OpenAI -------------------------------------------------------------
# Uses the OpenAI-compatible v1 endpoint: {endpoint}/openai/v1 with the deployment name as model.
# Set AZURE_OPENAI_API_VERSION to use the classic /openai/deployments/{deployment} endpoint instead.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=

# --- Anthropic ----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Ollama (local, no key) ---------------------------------------------------
# Pull a model with tool-calling support first, e.g. `ollama pull llama3.1`
OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- vLLM (local OpenAI-compatible server) ------------------------------------
# Start with tool calling enabled, e.g.
#   vllm serve <model> --enable-auto-tool-choice --tool-call-parser <parser>
VLLM_MODEL=
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=

# --- Any other OpenAI-compatible server (LM Studio, LiteLLM, Together, ...) ---
LLM_BASE_URL=
LLM_MODEL=
# LLM_API_KEY=
